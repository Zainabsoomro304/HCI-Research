{
  "name": "adaptive-ui-study",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run && vitest run -c vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:local": "tsx scripts/local-db.ts",
    "db:seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "catalog:images": "tsx scripts/catalog-images.ts",
    "catalog:check": "tsx scripts/catalog-check.ts",
    "tasks:check": "tsx scripts/tasks-check.ts",
    "clips:select": "tsx scripts/clips-select.ts",
    "clips:record": "tsx scripts/clips-record.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "participants:create": "tsx --env-file=.env scripts/participants-create.ts",
    "postinstall": "prisma generate",
    "db:migrate:create": "prisma migrate dev --create-only"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@prisma/client": "6.19.3",
    "jszip": "3.10.2",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "embedded-postgres": "17.10.0-beta.17",
    "ffmpeg-static": "5.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "ffmpeg-static",
      "esbuild",
      "embedded-postgres",
      "@embedded-postgres/windows-x64"
    ]
  }
}
