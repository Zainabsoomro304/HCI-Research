// Adaptive-UI preference study. PostgreSQL only (hosted: Neon / Supabase; tests: embedded Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ParticipantGroup {
  cs
  nonCs
  unknown
}

enum SessionType {
  phase1
  p3_sessionA
  p3_sessionB
}

enum SessionStatus {
  not_started
  in_progress
  completed
}

model Participant {
  id           String           @id @default(cuid())
  /// Generated code, e.g. P1-017 / P3-004. Never a personal name.
  code         String           @unique
  studyPhase   Int
  /// Sequence number within the phase (017 -> 17). Used for Latin-square rows.
  number       Int
  group        ParticipantGroup @default(unknown)
  /// "self" when derived from the questionnaire, "admin" when set by a researcher.
  groupSource  String?
  /** en | ur. Preset by the researcher or chosen by the participant on the welcome screen, before consent. */
  language     String           @default("en")
  /// Seed for every random draw for this participant (trial schedule, side assignment, ...).
  seed         Int
  notes        String?
  /// Admin overrides for Phase 3 Latin-square rows (0-3). Null = derived from `number`.
  conditionRowOverride Int?
  taskRowOverride      Int?
  completionCode String?
  /// Created by the test tools. Never allowed unless ALLOW_TEST_TOOLS=true; left out of exports by default.
  isSimulated  Boolean          @default(false)
  /// Test tools only: the true preferences behind a simulated participant's answers.
  simulatedTruth Json?
  /// Withdrawn participants are left out of the models and cannot start Session B.
  withdrawnAt  DateTime?
  withdrawnReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sessions        Session[]
  consents        ConsentRecord[]
  questionnaires  QuestionnaireResponse[]
  trials          ComparisonTrial[]
  breaks          BreakRecord[]
  taskBlocks      TaskBlock[]
  plans           AdaptationPlan[]
  rankings        Ranking[]
  events          Event[]

  @@unique([studyPhase, number])
}

model Session {
  id            String        @id @default(cuid())
  participantId String
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  type          SessionType
  /// Secret token in the participant link /s/<token>. Reusable until the session is completed (for resume).
  token         String        @unique
  status        SessionStatus @default(not_started)
  /// Current step pointer: language | consent | background | instructions | practice | trials | break | end | ineligible | sb_* ...
  currentStep   String        @default("language")
  /// en | ur: the language the session was done in (fixed once consent is given; Session B copies the participant's).
  language      String?
  /// Position (seq) of the next comparison trial / index of the current task block.
  currentIndex  Int           @default(0)
  /// Exact build (git commit) the participant used, captured when the session started.
  appVersion    String?
  userAgent     String?
  viewportW     Int?
  viewportH     Int?
  /// Phase 3 Session B Latin-square rows actually used.
  conditionRow  Int?
  taskRow       Int?
  /// Set when the researcher unlocks Session B from the admin panel.
  unlockedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  consent        ConsentRecord?
  questionnaires QuestionnaireResponse[]
  trials         ComparisonTrial[]
  breaks         BreakRecord[]
  taskBlocks     TaskBlock[]
  rankings       Ranking[]
  events         Event[]

  @@unique([participantId, type])
  @@index([participantId])
}

model ConsentRecord {
  id            String      @id @default(cuid())
  sessionId     String      @unique
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  /// SHA-256 of the consent text shown, so we know exactly which version was agreed to.
  consentTextHash String
  language      String
  consentedAt   DateTime    @default(now())
  clientTs      DateTime?

  @@index([participantId])
}

model QuestionnaireResponse {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// background | quis | ues_sf
  instrument    String
  /// Version / hash of the item file the responses refer to.
  instrumentVersion String?
  taskBlockId   String?
  taskBlock     TaskBlock?  @relation(fields: [taskBlockId], references: [id], onDelete: Cascade)
  /// Structured answers: { itemId: value }.
  responses     Json
  clientTs      DateTime?
  submittedAt   DateTime    @default(now())

  @@unique([sessionId, instrument, taskBlockId])
  @@index([participantId])
  @@index([sessionId])
}

model ComparisonTrial {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Overall presentation order within the session, 0-based, practice first.
  seq           Int
  /// 1-based trial number shown to the participant ("Trial X of N"); practice trials are numbered separately.
  trialIndex    Int
  isPractice    Boolean     @default(false)
  isRepeat      Boolean     @default(false)
  repeatOfTrialId String?
  repeatOf      ComparisonTrial?  @relation("RepeatOf", fields: [repeatOfTrialId], references: [id])
  repeats       ComparisonTrial[] @relation("RepeatOf")
  isAttentionCheck Boolean  @default(false)
  /// Product category shown in both clips of this trial.
  scene         String      @default("")
  /// Language of both clips (the participant's language when the schedule was made).
  language      String      @default("en")
  /// Clip IDs are target config IDs.
  leftClipId    String
  rightClipId   String
  /// Number of settings each clip changes from the base config (transition busyness), frozen at scheduling time.
  leftNumChangedSettings  Int
  rightNumChangedSettings Int
  // ---- response (filled when answered) ----
  choice        String?     // "left" | "right"
  chosenClipId  String?
  /// Reaction time from the moment both clips first finished playing.
  rtMs          Int?
  replayCount   Int?
  /// Client timestamps (epoch ms converted to DateTime).
  clientShownAt     DateTime?
  clientBothEndedAt DateTime?
  clientRespondedAt DateTime?
  serverRespondedAt DateTime?
  createdAt     DateTime    @default(now())

  @@unique([sessionId, seq])
  @@index([participantId])
  @@index([sessionId])
}

model BreakRecord {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Break shown after this analysis trial number.
  afterTrialIndex Int
  startedAt     DateTime
  endedAt       DateTime?
  durationMs    Int?

  @@unique([sessionId, afterTrialIndex])
  @@index([participantId])
}

model TaskBlock {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// 0-3 for the four task blocks; -1 for the practice task.
  blockIndex    Int
  isPractice    Boolean     @default(false)
  /// static | global | cluster5 | personalFull | practice
  condition     String
  taskId        String
  /// The adaptation plan steps used for this block, frozen at block creation.
  planSnapshot  Json
  /// Config IDs actually applied, in order, with timestamps.
  appliedConfigs Json?
  finalConfigId String?
  /// Final cart contents [{productId, quantity, price}].
  cart          Json?
  startedAt     DateTime?
  firstInteractionAt DateTime?
  finishedAt    DateTime?
  // ---- scores (computed server-side on finish) ----
  requiredItemsFound Int?
  withinBudget  Boolean?
  totalSpent    Int?
  durationMs    Int?
  extraItems    Int?

  questionnaires QuestionnaireResponse[]

  @@unique([sessionId, blockIndex])
  @@index([participantId])
  @@index([sessionId])
}

model AdaptationPlan {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  condition     String
  /// Validated steps array [{ trigger: {type, value}, config }].
  steps         Json
  /// "computed" by the freeze step or "uploaded" by hand (the advanced override).
  source        String      @default("uploaded")
  frozenModelId String?
  sourceFileName String?
  uploadedAt    DateTime    @default(now())

  @@unique([participantId, condition])
  @@index([participantId])
}

model Ranking {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// "Interface N" as shown = blockIndex + 1.
  blockIndex    Int
  condition     String
  taskId        String
  finalConfigId String
  /// 1 = most preferred.
  rank          Int
  reason        String?
  submittedAt   DateTime    @default(now())

  @@unique([sessionId, blockIndex])
  @@index([participantId])
}

model Event {
  id            BigInt      @id @default(autoincrement())
  /// Client-generated UUID; makes retried / late batches idempotent.
  clientEventId String      @unique
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Task block ID or comparison trial ID the event belongs to.
  trialId       String?
  configId      String?
  type          String
  clientTs      DateTime
  /// Raw client epoch ms (exact, for analysis).
  clientTsMs    BigInt
  serverTs      DateTime    @default(now())
  payload       Json?
  isPractice    Boolean     @default(false)

  @@index([participantId])
  @@index([sessionId])
  @@index([trialId])
}

/// One run of "Freeze models & generate plans". Only the newest record with status "active" is in force.
model FrozenModel {
  id            String   @id @default(cuid())
  version       Int      @unique
  /// active | superseded
  status        String   @default("active")
  appVersion    String?
  /// SHA-256 of the exact comparisons the models were built from.
  inputHash     String
  /// Engine settings and seeds in force.
  settings      Json
  /// Models from everyone included: sigma, nuisance terms, global model, clusters. Used for late participants.
  pool          Json
  /// One entry per participant: leave-one-out summary, targets and flags.
  results       Json
  /// Participant IDs and codes in model building.
  eligible      Json
  /// Everyone left out of model building, with the reason.
  excluded      Json
  warnings      Json
  simulatedCount Int     @default(0)
  /// True if any "unfreeze" was ever logged: the study's freezing rule was broken.
  compromised   Boolean  @default(false)
  computeMs     Int?
  createdAt     DateTime @default(now())
}

/// A freeze being computed in chunks. Plans and models are only written, in one transaction, once it has finished.
model FreezeJob {
  id          String   @id @default(cuid())
  /// running | done | failed | cancelled
  status      String   @default("running")
  inputHash   String
  /// Codes still to compute, in order.
  remaining   Json
  pool        Json?
  results     Json
  error       String?
  computeMs   Int      @default(0)
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Everything a researcher does to the frozen models, for the record. Exported as admin_actions.csv.
model AdminAction {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  /// freeze | unfreeze | withdraw | reinstate | late_plan | plan_upload | test_tools
  action    String
  reason    String?
  details   Json?

  @@index([at])
}

/// Native-speaker review of Urdu strings. A row means the string was marked as reviewed in the admin panel.
model TranslationReview {
  key        String   @id
  reviewedAt DateTime @default(now())
  note       String?
}
