# PostgreSQL connection string (Neon / Supabase). Use a separate database for development and for the real study.
DATABASE_URL="postgresql://user:password@host:5432/adaptive_ui_dev?sslmode=require"
# Some hosts (Neon, Supabase) need a direct, non-pooled URL for migrations. If not, set it equal to DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/adaptive_ui_dev?sslmode=require"
# Password for /admin
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie (any long random string)
SESSION_SECRET="replace-with-a-long-random-string"
# Public base URL used when generating participant links (no trailing slash)
PUBLIC_BASE_URL="http://localhost:3000"
